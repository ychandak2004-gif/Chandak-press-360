rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasUserProfile() { return signedIn() && exists(userPath()); }
    function userDoc() { return get(userPath()).data; }
    function activeUser() { return hasUserProfile() && userDoc().active == true; }
    function role() { return activeUser() ? userDoc().role : ""; }
    function admin() { return activeUser() && role() == "admin"; }
    function staff() { return activeUser() && role() == "staff"; }
    function agent() { return activeUser() && role() == "agent"; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create, update, delete: if admin();
    }
    match /products/{id} {
      allow read: if activeUser();
      allow write: if admin();
    }
    match /agents/{id} {
      allow read: if admin() || staff();
      allow create, update, delete: if admin();
    }
    match /orders/{id} {
      allow read: if admin() || staff() || (agent() && resource.data.agentId == request.auth.uid);
      allow create: if agent()
        && request.resource.data.agentId == request.auth.uid
        && request.resource.data.status == "Awaiting Payment"
        && request.resource.data.paymentStatus == "Unpaid"
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0;
      allow update: if admin() || (staff()
        && (
          (resource.data.paymentStatus == "Paid"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"]))
          || (resource.data.paymentStatus != "Paid"
            && request.resource.data.paymentStatus == "Paid"
            && request.resource.data.status == "Queued"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["paymentStatus","paidAmount","paidAt","status"]))
        ));
      allow delete: if admin();
    }
    match /payments/{id} {
      allow read: if admin() || staff() || (agent() && resource.data.agentId == request.auth.uid);
      allow create: if admin() || staff();
      allow update, delete: if admin();
    }
  }
}